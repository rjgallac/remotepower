# Environment Configuration Example
# Copy this file to .env and fill in with your actual values

# Server port (default: 3000)
PORT=3000

# SSH Configuration
SSH_USER=user
SSH_PASSWORD=mypassword

# Optional: Path to SSH private key (recommended instead of password)
# SSH_KEY_PATH=C:\Users\YourUsername\.ssh\id_rsa

# Note: If using SSH_KEY_PATH, SSH_PASSWORD will be ignored
